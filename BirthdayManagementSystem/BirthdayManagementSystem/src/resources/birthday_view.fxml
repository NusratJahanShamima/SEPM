<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="app.controller.BirthdayController">
    <top>
        <VBox spacing="10" padding="10">
            <TextField fx:id="nameField" promptText="Name" />
            <DatePicker fx:id="dobPicker" />
            <HBox spacing="10">
                <Button text="Add" onAction="#addBirthday" />
                <Button text="Update" onAction="#updateBirthday" />
                <Button text="Delete" onAction="#deleteBirthday" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" />
                <TableColumn fx:id="dobColumn" text="Date of Birth" />
            </columns>
        </TableView>
    </center>
</BorderPane>
